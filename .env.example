# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true

# Optional AI assistant (OpenAI-compatible Chat Completions endpoint)
ASSISTANT_API_KEY=
ASSISTANT_API_URL=https://api.openai.com/v1/chat/completions
ASSISTANT_MODEL=gpt-4o-mini

# Optional: official company number with country code, digits only
WHATSAPP_NUMBER=

# Requests allowed per session per minute
ASSISTANT_RATE_LIMIT=12
